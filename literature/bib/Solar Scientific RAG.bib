	annote = {Comment: 23 pages, 5 figures, and 6 tables},
	file = {Preprint PDF:C\:\\Users\\idrid\\Zotero\\storage\\V7LFU29W\\Jiang et al. - 2026 - Agentic Hybrid RAG for Evidence-Grounded Muon Collider Analysis.pdf:application/pdf},
